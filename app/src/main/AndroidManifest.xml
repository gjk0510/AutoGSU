<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 开机完成后重新注册定时任务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 命令执行期间短时间保持 CPU 唤醒（有硬超时，及时释放） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 引导用户将应用加入电池优化白名单（配合自启动，保证 Doze/后台能唤醒） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 精确闹钟（setExactAndAllowWhileIdle）：Android 12+ 需用户在系统设置授予「闹钟和提醒」 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 常驻通知模式：前台服务动态注册解锁/关屏广播 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoSU">

        <!-- 同时作为 LSPosed 模块：解锁/关屏 hook（免常驻通知）。作用域需勾选 Android 系统 + 系统界面 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="AutoGSU：解锁/关屏事件 hook（免常驻通知）" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AutoSU">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 接收闹钟事件（仅由本应用的 PendingIntent 触发） -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="false" />

        <!-- 开机完成 / 快速开机广播，用于恢复定时任务并执行开机类任务 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 关机广播：尽力而为，多数机型收不到 -->
        <receiver
            android:name=".ShutdownReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
            </intent-filter>
        </receiver>

        <!-- LSP 模式事件入口：由 system_server / SystemUI 显式广播拉起（仅 LSP 模式生效） -->
        <receiver
            android:name=".LspEventReceiver"
            android:exported="true" />

        <!-- 常驻通知模式：前台服务内动态注册解锁/关屏广播 -->
        <service
            android:name=".EventForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="解锁/关屏事件监听" />
        </service>
    </application>

</manifest>