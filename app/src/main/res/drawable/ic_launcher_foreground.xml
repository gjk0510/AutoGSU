<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 512 画布内容缩放 0.15 并居中：p -> 54 + 0.15 * (p - 256) -->
    <group
        android:scaleX="0.15"
        android:scaleY="0.15"
        android:translateX="15.6"
        android:translateY="15.6">

        <!-- 终端箭头 -->
        <path
            android:pathData="M100,180 L190,256 L100,332"
            android:strokeWidth="25"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="100"
                    android:startY="180"
                    android:endX="190"
                    android:endY="332">
                    <item android:offset="0.0" android:color="#FFB5FF69" />
                    <item android:offset="1.0" android:color="#FF21D77B" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 终端提示符下划线 -->
        <path
            android:pathData="M205,332 L280,332"
            android:strokeColor="#B5FF69"
            android:strokeWidth="25"
            android:strokeLineCap="round" />

        <!-- 表盘 -->
        <path
            android:pathData="M254,235 a91,91 0 1,0 182,0 a91,91 0 1,0 -182,0"
            android:fillColor="#111E25" />
        <path
            android:pathData="M254,235 a91,91 0 1,0 182,0 a91,91 0 1,0 -182,0"
            android:strokeWidth="13">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="254"
                    android:startY="144"
                    android:endX="436"
                    android:endY="326">
                    <item android:offset="0.0" android:color="#FFB5FF69" />
                    <item android:offset="1.0" android:color="#FF21D77B" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 表盘刻度 -->
        <path
            android:pathData="M345,160 L345,174"
            android:strokeColor="#B5FF69"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M345,296 L345,310"
            android:strokeColor="#B5FF69"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M270,235 L284,235"
            android:strokeColor="#B5FF69"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M406,235 L420,235"
            android:strokeColor="#B5FF69"
            android:strokeWidth="8"
            android:strokeLineCap="round" />

        <!-- 时针 / 分针 / 圆心 -->
        <path
            android:pathData="M345,235 L345,185"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="11"
            android:strokeLineCap="round" />
        <path
            android:pathData="M345,235 L382,256"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="11"
            android:strokeLineCap="round" />
        <path
            android:pathData="M335,235 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
            android:fillColor="#B5FF69" />

        <!-- Root 徽标 -->
        <path
            android:pathData="M365,365 a35,35 0 1,0 70,0 a35,35 0 1,0 -70,0"
            android:fillColor="#21D77B"
            android:strokeColor="#111E25"
            android:strokeWidth="9" />
        <path
            android:pathData="M384,365 L396,377 L417,352"
            android:strokeColor="#08150E"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
